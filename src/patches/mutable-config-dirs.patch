+// Runtime enablement doesn't survive a reboot, so record which units are
+// enabled for the snapd wrapper to start them on boot
+func markEnabled(serviceNames []string, enabled bool) error {
+	dir := filepath.Join(dirs.GlobalRootDir, "/var/lib/snapd/nix-systemd-system-enabled")
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return err
+	}
+	for _, serviceName := range serviceNames {
+		path := filepath.Join(dir, serviceName)
+		if enabled {
+			if err := os.WriteFile(path, nil, 0644); err != nil {
+				return err
+			}
+		} else if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+			return err
+		}
+	}
+	return nil
+}
